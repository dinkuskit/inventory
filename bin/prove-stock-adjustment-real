#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
cd "$repo_root"

proof_temp=$(mktemp -d)
proof_pid=""
cleanup() {
	if [ -n "$proof_pid" ]; then
		kill "$proof_pid" 2>/dev/null || true
		wait "$proof_pid" 2>/dev/null || true
	fi
	rm -rf -- "$proof_temp"
}
trap cleanup EXIT HUP INT TERM

proof_port=${DINKUSKIT_INVENTORY_STOCK_PROOF_PORT:-18788}
case "$proof_port" in
	*[!0-9]*|'')
		echo "DINKUSKIT_INVENTORY_STOCK_PROOF_PORT must be a port number." >&2
		exit 2
		;;
esac

start_runtime() {
	npm exec -- wrangler dev \
		--local \
		--persist-to "$proof_temp/cloudflare-state" \
		--ip 127.0.0.1 \
		--port "$proof_port" \
		--log-level error \
		-c wrangler.stock-adjustment-proof.jsonc \
		>"$proof_temp/wrangler.log" 2>&1 &
	proof_pid=$!
}

stop_runtime() {
	kill "$proof_pid"
	wait "$proof_pid" 2>/dev/null || true
	proof_pid=""
}

request_action() {
	action=$1
	output=$2
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		if curl --fail --silent \
			--request POST \
			--header 'content-type: application/json' \
			--data "{\"action\":\"$action\"}" \
			--output "$output" \
			"http://127.0.0.1:$proof_port/"; then
			return 0
		fi
		if ! kill -0 "$proof_pid" 2>/dev/null; then
			echo "Local Wrangler runtime exited before serving the proof request." >&2
			sed -n '1,120p' "$proof_temp/wrangler.log" >&2
			return 1
		fi
		attempt=$((attempt + 1))
		sleep 0.1
	done
	echo "Timed out waiting for the local Wrangler runtime." >&2
	return 1
}

echo '$ wrangler dev --local --persist-to <temporary-cloudflare-state> -c wrangler.stock-adjustment-proof.jsonc'
echo '$ curl --request POST --data {"action":"commit"} http://127.0.0.1:<temporary-port>/'
start_runtime
request_action commit "$proof_temp/commit.json"
stop_runtime

state_file_count=$(find "$proof_temp/cloudflare-state" -type f | wc -l | tr -d ' ')
if [ "$state_file_count" -lt 1 ]; then
	echo "Wrangler did not persist local Durable Object state." >&2
	exit 1
fi

echo '$ stop Wrangler, reopen the same temporary persisted state, and replay the exact command'
start_runtime
request_action replay "$proof_temp/replay.json"
stop_runtime

node tools/assert-stock-adjustment-real-proof.mjs \
	"$proof_temp/commit.json" \
	"$proof_temp/replay.json" \
	"$state_file_count"
