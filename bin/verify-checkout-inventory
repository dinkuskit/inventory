#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
cd "$repo_root"

node --experimental-sqlite --experimental-strip-types \
	--test tests/checkout-inventory/*.test.mjs

npx vitest run --config vitest.config.ts \
	tests/cloudflare/checkout-inventory.test.mjs

node --experimental-sqlite --experimental-strip-types \
	tools/checkout-inventory-commerce-port-proof.mjs

exec npm run typecheck:cloudflare
