#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
cd "$repo_root"

node --experimental-sqlite --experimental-strip-types \
	--test tests/managed-sku/register-managed-sku.test.mjs

node --experimental-sqlite --experimental-strip-types \
	--test tests/inventory/aggregate-stock-read.test.mjs

npm run test:cloudflare

exec npm run typecheck:cloudflare
