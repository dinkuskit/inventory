#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
cd "$repo_root"

node --experimental-sqlite --experimental-strip-types \
	--test tests/opening-balance/*.test.mjs

exec node --experimental-sqlite --experimental-strip-types \
	scripts/verify-active-location-admission.mjs
