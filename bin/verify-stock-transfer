#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
cd "$repo_root"

node --experimental-sqlite --experimental-strip-types \
	--test tests/stock-transfer/*.test.mjs

npx vitest run --config vitest.config.ts \
	tests/cloudflare/stock-transfer.test.mjs \
	tests/cloudflare/inventory-pool.test.mjs

exec npm run typecheck:cloudflare
