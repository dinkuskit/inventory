{
  "name": "@dinkuskit/inventory",
  "version": "0.0.0",
  "description": "The inventory ledger for EmDash sites",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/inventory.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:cloudflare",
    "test:node": "node --experimental-sqlite --experimental-strip-types --test tests/workflows/*.test.mjs tests/opening-balance/*.test.mjs tests/locations/*.test.mjs",
    "test:cloudflare": "vitest run --config vitest.config.ts",
    "typecheck:cloudflare": "tsc --project tsconfig.cloudflare.json",
    "verify:opening-balance": "bin/verify-opening-balance",
    "verify:cloudflare-storage": "bin/verify-cloudflare-storage",
    "verify:location-registry": "bin/verify-location-registry"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.1",
    "@cloudflare/workers-types": "5.20260828.1",
    "emdash": "0.35.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  }
}
