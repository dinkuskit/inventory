{
  "name": "@dinkuskit/inventory",
  "version": "0.0.0",
  "description": "The inventory ledger for EmDash sites",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/inventory.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:cloudflare",
    "test:node": "node --experimental-sqlite --experimental-strip-types --test tests/workflows/*.test.mjs tests/opening-balance/*.test.mjs tests/locations/*.test.mjs tests/inventory/*.test.mjs tests/managed-sku/*.test.mjs tests/stock-adjustment/*.test.mjs tests/stock-transfer/*.test.mjs tests/stock-reservation/*.test.mjs tests/checkout-inventory/*.test.mjs tests/hosted-onboarding/*.test.mjs tests/store-connect/*.test.mjs",
    "test:cloudflare": "vitest run --config vitest.config.ts",
    "typecheck:cloudflare": "tsc --project tsconfig.cloudflare.json",
    "audit:features": "node scripts/check-architecture.mjs",
    "verify:quick": "bin/verify-inventory quick",
    "verify:full": "bin/verify-inventory full",
    "verify:opening-balance": "bin/verify-opening-balance",
    "verify:cloudflare-storage": "bin/verify-cloudflare-storage",
    "verify:location-registry": "bin/verify-location-registry",
    "verify:aggregate-stock-read": "bin/verify-aggregate-stock-read",
    "verify:managed-sku": "bin/verify-managed-sku",
    "verify:stock-adjustment": "bin/verify-stock-adjustment",
    "verify:stock-transfer": "bin/verify-stock-transfer",
    "verify:stock-reservation": "bin/verify-stock-reservation",
    "verify:checkout-inventory": "bin/verify-checkout-inventory",
    "proof:aggregate-stock-read:real": "bin/prove-aggregate-stock-read-real",
    "proof:stock-adjustment:real": "bin/prove-stock-adjustment-real",
    "proof:stock-reservation:real": "bin/prove-stock-reservation-real",
    "test:hosted": "vitest run --config vitest.hosted.config.ts",
    "build:plugin": "cd plugins/emdash-inventory && emdash-plugin build",
    "bundle:plugin": "cd plugins/emdash-inventory && emdash-plugin bundle",
    "typecheck:plugin": "tsc --project tsconfig.plugin.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.1",
    "@cloudflare/workers-types": "5.20260828.1",
    "@emdash-cms/blocks": "1.2.0",
    "@emdash-cms/plugin-cli": "0.13.3",
    "@emdash-cms/sandbox-workerd": "0.9.3",
    "emdash": "1.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  },
  "dependencies": {
    "jose": "6.2.12",
    "zod": "4.5.4"
  },
  "overrides": {
    "astro": "7.2.9",
    "@astrojs/react": "6.0.4",
    "vite": {
      ".": "8.2.2",
      "rolldown": "1.2.6"
    },
    "@codemirror/language": "6.12.4"
  }
}
