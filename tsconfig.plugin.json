{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "plugins/emdash-inventory/src/**/*.ts",
    "src/features/store-connect/**/*.ts"
  ]
}
