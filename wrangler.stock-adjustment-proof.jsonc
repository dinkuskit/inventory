{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dinkuskit-inventory-stock-adjustment-proof",
	"main": "tools/stock-adjustment-local-proof.ts",
	"compatibility_date": "2026-08-28",
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "STOCK_ADJUSTMENT_PROOF_POOLS",
				"class_name": "StockAdjustmentProofPool"
			}
		]
	},
	"exports": {
		"StockAdjustmentProofPool": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
